---
import Base from '../layouts/Base.astro';
import { CONTENT } from '../i18n/content';

const content = CONTENT.es;
---
<Base lang="es" content={content} pathname="/404">
  <main id="main" class="tf-404">
    <span class="tf-mono tf-404-code">[ 404 — Página no encontrada ]</span>
    <h1 class="tf-404-title">No encontramos esa ruta.</h1>
    <p class="tf-404-sub">
      Es posible que la página haya sido movida o que la dirección esté mal escrita.
      Volvé al inicio para seguir explorando Trans-Fil.
    </p>
    <div class="tf-404-actions">
      <a href="/" class="tf-btn tf-btn-primary">
        <span>Volver al inicio</span>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </a>
      <a href="/en/" class="tf-btn tf-btn-ghost">English version</a>
    </div>
  </main>
</Base>

<style>
  .tf-404 {
    min-height: calc(100vh - 200px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(72px, 10vw, 140px) clamp(20px, 4vw, 96px);
    max-width: 720px;
    margin: 0 auto;
    gap: 20px;
  }
  .tf-404-code {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tf-404-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 7vw, 88px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }
  .tf-404-sub {
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--fg-2);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0;
  }
  .tf-404-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
</style>
