            <circle class="tf-sd-drop" cx="570" cy="408" r="4.4" fill="#3a86ff" style="--sd-d: 1.35s" />
            <circle class="tf-sd-drop" cx="625" cy="408" r="4" fill="#3a86ff" style="--sd-d: 1.8s" />
          </g>

