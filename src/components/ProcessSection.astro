---
import type { Content } from '../i18n/content';
const { content } = Astro.props as { content: Content };
const c = content.process;
---

<section
  id="process"
  class="section-proceso"
  data-screen-label="03 Process"
  aria-labelledby="proceso-heading"
>
  <div class="eyebrow reveal">{c.eyebrow}</div>
  <h2 id="proceso-heading" class="heading reveal" style="--reveal-delay: 120ms">
    {c.title}
  </h2>
  <p class="lead reveal" style="--reveal-delay: 260ms">{c.lead}</p>

  <ol class="flow" aria-label={c.eyebrow}>
    {c.steps.map((s) => (
      <li class="node">
        <div class="node-head">
          <span class="node-num">{s.n}</span>
          <span class="node-dot" aria-hidden="true"></span>
        </div>
        <h3 class="node-title">{s.t}</h3>
        <p class="node-desc">{s.d}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .section-proceso,
  .section-proceso *,
  .section-proceso *::before,
  .section-proceso *::after {
    box-sizing: border-box;
  }

  .section-proceso {
    --tf-bg: #0a0a0c;
    --tf-text: #f5f5f4;
    --tf-text-2: #c8c8c8;
    --tf-text-3: #909090;
    --tf-accent: #1aa8e2;
    --tf-border: rgba(255, 255, 255, 0.08);
    --tf-card-bg: rgba(12, 13, 16, 0.62);
    --tf-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

    position: relative;
    overflow: hidden;
    background-color: var(--tf-bg);
    background-image: url('/images/proceso-bg.jpg');
    background-size: cover;
    background-position: center;
    color: var(--tf-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    padding: 96px 8vw 80px;
    min-height: 720px;
  }
  .section-proceso::before,
  .section-proceso::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .section-proceso::before {
    background: linear-gradient(
      180deg,
      rgba(8, 8, 10, 0.78) 0%,
      rgba(8, 8, 10, 0.45) 32%,
      rgba(8, 8, 10, 0.45) 60%,
      rgba(8, 8, 10, 0.88) 100%
    );
  }
  .section-proceso::after {
    background: radial-gradient(
      ellipse 95% 70% at 50% 50%,
      transparent 30%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }
  .section-proceso > * {
    position: relative;
    z-index: 1;
  }

  .section-proceso .eyebrow {
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--tf-text-2);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 28px;
  }
  .section-proceso .eyebrow::before {
    content: '';
    width: 32px;
    height: 1px;
    background: var(--tf-text-2);
  }

  .section-proceso .heading {
    font-size: clamp(28px, 4.2vw, 52px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
    max-width: 880px;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
    color: #fff;
  }

  .section-proceso .lead {
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.6;
    color: var(--tf-text-2);
    max-width: 580px;
    margin: 0 0 88px;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }

  .section-proceso .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
    align-items: stretch;
  }

  .section-proceso .node {
    position: relative;
    padding: 22px 20px;
    background: var(--tf-card-bg);
    border: 1px solid var(--tf-border);
    border-radius: 4px;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .section-proceso .node-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .section-proceso .node-num {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--tf-accent);
    font-weight: 600;
  }
  .section-proceso .node-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tf-accent);
  }
  .section-proceso .node-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 10px;
    color: #fff;
    line-height: 1.25;
  }
  .section-proceso .node-desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--tf-text-3);
    margin: 0;
  }

  /* Chevron arrows between adjacent nodes (desktop) */
  .section-proceso .node + .node::before {
    content: '';
    position: absolute;
    left: -16px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid var(--tf-accent);
    border-right: 1.5px solid var(--tf-accent);
    transform: translateY(-50%) rotate(45deg);
    opacity: 0;
    transition: opacity 0.5s var(--tf-ease);
  }

  /* Reveal-on-scroll initial states */
  .section-proceso .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s var(--tf-ease), transform 0.7s var(--tf-ease);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .section-proceso .node {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s var(--tf-ease), transform 0.7s var(--tf-ease);
  }

  /* Reveal-on-scroll active states */
  .section-proceso.is-visible .reveal {
    opacity: 1;
    transform: translateY(0);
  }
  .section-proceso.is-visible .node {
    opacity: 1;
    transform: translateY(0);
  }
  .section-proceso.is-visible .node:nth-child(1) { transition-delay: 500ms; }
  .section-proceso.is-visible .node:nth-child(2) { transition-delay: 600ms; }
  .section-proceso.is-visible .node:nth-child(3) { transition-delay: 700ms; }
  .section-proceso.is-visible .node:nth-child(4) { transition-delay: 800ms; }
  .section-proceso.is-visible .node:nth-child(5) { transition-delay: 900ms; }
  .section-proceso.is-visible .node:nth-child(2)::before { opacity: 0.85; transition-delay: 700ms; }
  .section-proceso.is-visible .node:nth-child(3)::before { opacity: 0.85; transition-delay: 800ms; }
  .section-proceso.is-visible .node:nth-child(4)::before { opacity: 0.85; transition-delay: 900ms; }
  .section-proceso.is-visible .node:nth-child(5)::before { opacity: 0.85; transition-delay: 1000ms; }

  /* Mobile: stack vertically with vertical timeline line + dots */
  @media (max-width: 880px) {
    .section-proceso { padding: 64px 6vw 56px; }
    .section-proceso .lead { margin-bottom: 56px; }
    .section-proceso .flow {
      grid-template-columns: 1fr;
      gap: 18px;
      position: relative;
    }
    .section-proceso .flow::before {
      content: '';
      position: absolute;
      left: 14px;
      top: 24px;
      bottom: 24px;
      width: 1px;
      background: rgba(255, 255, 255, 0.12);
    }
    .section-proceso .node {
      padding: 18px 20px 18px 36px;
    }
    .section-proceso .node-head { margin-bottom: 10px; }
    .section-proceso .node + .node::before { display: none; }
    .section-proceso .node::after {
      content: '';
      position: absolute;
      left: 11px;
      top: 30px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--tf-accent);
      box-shadow: 0 0 0 4px var(--tf-bg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-proceso .reveal,
    .section-proceso .node,
    .section-proceso .node + .node::before {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('.section-proceso');
  if (sections.length) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18 }
      );
      sections.forEach((s) => io.observe(s));
    } else {
      sections.forEach((s) => s.classList.add('is-visible'));
    }
  }
</script>
