            <path d="M790 616v-12h167v-48" />
            <path d="M983 616v-10h117v-56" />
            <path d="M1246 616v-38" />
          </g>
          <g fill="#6d6d77">
            <circle cx="42" cy="116" r="3" fill="#8f5c2d" />
            <circle cx="274" cy="150" r="3" />
            <circle cx="284" cy="310" r="3" />
            <circle cx="678" cy="250" r="3" />
            <circle cx="760" cy="314" r="3" />
            <circle cx="830" cy="276" r="3" />
            <circle cx="102" cy="560" r="3" />
            <circle cx="520" cy="576" r="3" />
            <circle cx="957" cy="552" r="3" />
            <circle cx="1100" cy="548" r="3" />
            <circle cx="1246" cy="578" r="3" />
          </g>

          {/* ── foco de etapa: ticks de esquina, al estilo de un plano ── */}
          <g class="tf-sd-focus" fill="none" stroke="#3a86ff" stroke-width="1.6" opacity=".6">
