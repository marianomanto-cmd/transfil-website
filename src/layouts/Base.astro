---
// Fonts are self-hosted (@fontsource-variable, the same variable woff2 files
// Google Fonts served): no third-party stylesheet blocking first paint, no
// extra DNS + TLS to two Google hosts, and no visitor IP sent to Google
// before consent. Each family ships per-script subsets behind unicode-range,
// so a page only downloads the ones its text uses.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
// Latin subsets of the two faces above the fold (body copy + display
// headline), preloaded so first text paints in the right face. `?url`
// resolves to the same hashed file the @font-face rules point at.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import ThreeImportMap from '../components/ThreeImportMap.astro';
import type { Content, Lang } from '../i18n/content';
import {
  SITE,
  LOCALES,
  LOCALE_META,
  altOgLocales,
  alternatesFor,
  urlFor,
  type PageKey,
} from '../i18n/routes';

interface Props {
  lang: Lang;
  content: Content;
  /**
   * Routable page key. Drives canonical + the reciprocal hreflang block.
   * Omitted only by the 404, which is `noindex` and has no alternates.
   */
  page?: PageKey;
  /** Explicit path — only needed when `page` is absent (404). */
  pathname?: string;
  noindex?: boolean;
  /** Per-page SEO overrides. Landings pass their own; the homes don't. */
  meta?: Partial<Content['meta']>;
  /** Page-specific share image. Defaults to the site-wide og-image.jpg. */
  ogImage?: { src: string; width: number; height: number };
  /** FAQ powering the FAQPage JSON-LD + the sr-only block. */
  faq?: { q: string; a: string }[];
  /** Long-form prose for the sr-only About block. */
  about?: string;
  /** Extra JSON-LD nodes (WebPage / Service / BreadcrumbList on landings). */
  extraJsonLd?: Record<string, unknown>[];
  /** Above-the-fold image to preload — the page's LCP candidate. */
  preloadImage?: string;
}

const {
  lang,
  content,
  page,
  pathname,
  noindex = false,
  meta: metaOverride,
  ogImage: ogImageOverride,
  faq = content.faq,
  about = content.about,
  extraJsonLd = [],
  preloadImage,
} = Astro.props;

const site = SITE;
const canonical = page ? urlFor(page, lang) : `${site}${pathname ?? '/'}`;
const meta = { ...content.meta, ...metaOverride };
const og = ogImageOverride ?? { src: '/img/og-image.jpg', width: 1200, height: 630 };
const ogImage = `${site}${og.src}`;
const ogImageType = og.src.endsWith('.webp')
  ? 'image/webp'
  : og.src.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';
const alternates = page ? alternatesFor(page) : [];
const xDefault = page ? urlFor(page, 'es') : null;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site}/#organization`,
  name: 'Trans-Fil S.R.L.',
  alternateName: 'Trans-Fil',
  url: `${site}/`,
  logo: `${site}/favicon-512.png`,
  image: ogImage,
  description: meta.description,
  foundingDate: '1989',
  founders: [{ '@type': 'Person', name: 'Mantovani' }],
  inLanguage: content.htmlLang,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Francisco de Arteaga 2895',
    addressLocality: 'Córdoba',
    addressRegion: 'Córdoba',
    addressCountry: 'AR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -31.4036,
    longitude: -64.1924,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+5493513820321',
      contactType: 'sales',
      email: 'ventas@transfil.com.ar',
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Brazil' },
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Country', name: 'Peru' },
        { '@type': 'Country', name: 'Bolivia' },
        { '@type': 'Country', name: 'Paraguay' },
        { '@type': 'Country', name: 'Uruguay' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Country', name: 'Ecuador' },
        { '@type': 'Country', name: 'Mexico' },
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'Dominican Republic' },
        { '@type': 'Country', name: 'Puerto Rico' },
        { '@type': 'Country', name: 'Spain' },
      ],
      availableLanguage: LOCALES.map((l) => LOCALE_META[l].schemaLanguage),
    },
  ],
  industry: 'Industrial Machinery Manufacturing',
  makesOffer: content.tech.map((t) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Product',
      '@id': `${site}/#product-${t.id}`,
      name: t.title,
      description: t.desc,
      category: 'Industrial Machinery',
      manufacturer: { '@id': `${site}/#organization` },
    },
  })),
};

// Each service Trans-Fil provides (S01..S04 in content.services.items)
// as its own Service node, attributed back to the org via @id.
const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': content.services.items.map((s) => ({
    '@type': 'Service',
    '@id': `${site}/#service-${s.code.toLowerCase()}`,
    name: s.title,
    description: s.desc,
    serviceType: s.title,
    provider: { '@id': `${site}/#organization` },
    areaServed: { '@id': `${site}/#organization` },
  })),
};

// FAQPage with the bilingual Q&A list — primary surface for AI search
// engines (Perplexity / ChatGPT / Google AI Overviews) to cite Trans-Fil
// answers about location, products, history, countries served, etc.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: content.htmlLang,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---
<!doctype html>
<html lang={content.htmlLang} data-page={page ?? '404'} data-locale={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Primero de todo: tiene que preceder a cualquier <script type="module">. */}
    <ThreeImportMap />

    {/* Medición — ver docs/MEDICION.md. Va ANTES de GTM: deja página e idioma
        en el dataLayer para que la configuración de GA4 ya los tenga al
        cargar, y define window.tfTrack, el único punto por donde sale cada
        evento del sitio.
        · Contexto: data-page / data-locale del <html>. Con View Transitions
          Astro copia los atributos del <html> nuevo al navegar, así que
          siempre describe la página que se ve.
        · Un listener delegado en document (captura) cubre todo link actual
          y futuro: WhatsApp (whatsapp_click es la conversión; click_whatsapp
          queda por compatibilidad con GTM y no se marca como conversión),
          teléfono, mail, idioma y CTAs con data-cta.
        · cta_location: zona marcada con data-track-zone, el FAB, header,
          footer o la sección con id que contiene el link.
        · section_view: una vez por sección y por página, cuando su parte de
          arriba entra al 60 % superior de la pantalla (con un umbral de
          visibilidad, una sección más alta que la pantalla no dispararía).
        · page_view: la carga inicial la manda la configuración de GA4; cada
          navegación con View Transitions empuja su contexto y su page_view.
        Los comentarios van acá y no en el script: lo inline se publica tal
        cual en cada página. */}
    <script is:inline>
      (function () {
        if (window.tfTrack) return;
        var w = window, d = document;
        w.dataLayer = w.dataLayer || [];
        function ctx() {
          var r = d.documentElement;
          return {
            page: r.getAttribute('data-page') || 'other',
            locale: r.getAttribute('data-locale') || 'es',
          };
        }
        w.tfTrack = function (event, params) {
          var o = ctx();
          o.event = event;
          if (params) for (var k in params) if (params[k] !== undefined) o[k] = params[k];
          w.dataLayer.push(o);
        };
        w.dataLayer.push(ctx());

        function zone(el) {
          var z = el.closest('[data-track-zone]');
          if (z) return z.getAttribute('data-track-zone');
          if (el.closest('.tf-wa-fab')) return 'fab';
          if (el.closest('header')) return 'header';
          if (el.closest('footer')) return 'footer';
          var s = el.closest('section[id]');
          return s ? s.id : 'other';
        }

        d.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = (a.getAttribute('href') || '').toLowerCase();
          var where = zone(a);
          var url = a.href;
          if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
            w.tfTrack('whatsapp_click', { lead_type: 'whatsapp', cta_location: where, link_url: url });
            w.tfTrack('click_whatsapp', { link_url: url });
            return;
          }
          if (href.indexOf('tel:') === 0) {
            w.tfTrack('click_phone', { cta_location: where, link_url: url });
            return;
          }
          if (href.indexOf('mailto:') === 0) {
            w.tfTrack('email_click', { cta_location: where, link_url: url });
            return;
          }
          var hl = a.getAttribute('hreflang');
          if (hl && a.closest('header')) {
            var from = ctx().locale;
            var to = hl.slice(0, 2).toLowerCase();
            if (to !== from) w.tfTrack('language_switch', { from_locale: from, to_locale: to });
            return;
          }
          var cta = a.getAttribute('data-cta');
          if (cta) w.tfTrack('cta_click', { cta: cta, cta_location: where, link_url: url });
        }, true);

        var io = null;
        function watchSections() {
          if (io) io.disconnect();
          if (!('IntersectionObserver' in w)) return;
          io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (!entries[i].isIntersecting) continue;
              io.unobserve(entries[i].target);
              w.tfTrack('section_view', { section: entries[i].target.id });
            }
          }, { rootMargin: '0px 0px -40% 0px' });
          var ss = d.querySelectorAll('main section[id]');
          for (var j = 0; j < ss.length; j++) io.observe(ss[j]);
        }

        var first = true;
        d.addEventListener('astro:page-load', function () {
          watchSections();
          if (first) { first = false; return; }
          w.dataLayer.push(ctx());
          w.tfTrack('page_view', {
            page_path: location.pathname + location.search,
            page_title: d.title,
            page_location: location.href,
          });
        });
      })();
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PV9STD3');</script>
    <!-- End Google Tag Manager -->

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0e0e10" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trans-Fil" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta property="og:locale" content={content.ogLocale} />
    {altOgLocales(lang).map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.twitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(servicesJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    {extraJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={groteskLatin} crossorigin />
    <ClientRouter />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PV9STD3"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a class="tf-skip-link" href="#main">{content.ui.skipToContent}</a>

    {/* Visually-hidden but indexable 'About' block for AI search engines
        and screen readers. Mirrors the FAQPage JSON-LD in human-readable
        prose so crawlers can extract facts even without parsing JSON-LD. */}
    <section class="tf-sr-only" aria-labelledby="about-heading">
      <h2 id="about-heading">{content.ui.aboutHeading}</h2>
      <p>{about}</p>
      <h3>{content.ui.faqHeading}</h3>
      <dl>
        {faq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))}
      </dl>
    </section>

    <slot />
    <script>
      import { goToAnchor } from '../lib/anchor';

      function init() {
        // Reveal-on-scroll
        const sections = document.querySelectorAll('.tf-section');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1 }
        );
        sections.forEach((s) => io.observe(s));

        // Split section H2 text into per-word spans so the headline cascades
        // word-by-word. Skip headings that already have manual <span>/<em>
        // children (e.g. Industries title which has a two-tone split).
        document.querySelectorAll('.tf-h2').forEach((h) => {
          if (h.querySelector('span, em')) return;
          if ((h as HTMLElement).dataset.split === '1') return;
          (h as HTMLElement).dataset.split = '1';
          const text = h.textContent || '';
          h.textContent = '';
          let i = 0;
          for (const part of text.split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              h.appendChild(document.createTextNode(part));
            } else {
              const w = document.createElement('span');
              w.textContent = part;
              w.style.setProperty('--i', String(i++));
              h.appendChild(w);
            }
          }
        });

        // Magnetic primary CTA — subtle attraction to cursor (fine pointers,
        // and only when the user hasn't opted out of motion).
        if (
          window.matchMedia('(pointer: fine)').matches &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          const bind = (btn: HTMLElement) => {
            let raf = 0;
            const reset = () => {
              btn.style.transform = '';
            };
            btn.addEventListener('mousemove', (e: MouseEvent) => {
              if (raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                const r = btn.getBoundingClientRect();
                const dx = (e.clientX - (r.left + r.width / 2)) * 0.25;
                const dy = (e.clientY - (r.top + r.height / 2)) * 0.25;
                btn.style.transform = `translate(${dx}px, ${dy}px)`;
              });
            });
            btn.addEventListener('mouseleave', reset);
          };
          const scan = () =>
            document.querySelectorAll('.tf-btn-magnetic').forEach((b) => {
              if (!(b as HTMLElement).dataset.magnetic) {
                (b as HTMLElement).dataset.magnetic = '1';
                bind(b as HTMLElement);
              }
            });
          scan();
          if (!(window as any).__tfMagObs) {
            (window as any).__tfMagObs = true;
            new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
          }
        }
      }

      // In-page anchors (skip-link included) — bound once. With ClientRouter
      // the <script> in the body re-executes on each transition, so guard
      // with a window flag to avoid stacking listeners. `goToAnchor` moves
      // focus along with the scroll and honours reduced motion.
      // Deliberately not skipped when defaultPrevented: ClientRouter's own
      // listener runs first and prevents every same-origin link (it then
      // sets the hash itself, which the tech accordion's hashchange deep
      // links rely on). Islands that handle their anchors (Header, Hero)
      // call goToAnchor too; running it twice on one target is harmless.
      if (!(window as any).__tfClickBound) {
        (window as any).__tfClickBound = true;
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const a = target.closest('a[href^="#"]') as HTMLAnchorElement | null;
          if (!a) return;
          const href = a.getAttribute('href');
          if (!href || href === '#') return;
          const el = document.getElementById(decodeURIComponent(href.slice(1)));
          if (!el) return;
          e.preventDefault();
          goToAnchor(el);
        });
      }

      // astro:page-load fires on the initial load AND after each view transition.
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
