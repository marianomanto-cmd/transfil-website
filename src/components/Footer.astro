---
import type { Content } from '../i18n/content';

interface Props { content: Content }
const { content } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="tf-footer">
  <div class="tf-footer-grid">
    <div class="tf-footer-brand">
      <div class="tf-logo-mark" aria-hidden="true">
        <svg viewBox="0 0 228 192" width="48" height="40" preserveAspectRatio="xMidYMid meet">
          <g transform="translate(-17 229) scale(0.1 -0.1)" fill="currentColor">
            <path d="M1341 2247 l-18 -43 -8 -33 -7 -32 -14 -27 -14 -27 0 -17 0 -17 -14 -33 -14 -33 -57 -180 -57 -180 -8 -20 -9 -20 -6 -25 -6 -25 -13 -35 -13 -35 -38 -120 -37 -120 -14 -33 -14 -33 0 -15 0 -16 -14 -31 -14 -32 -28 -88 -27 -89 -24 -9 -24 -9 -340 0 -339 0 2 -247 3 -248 565 0 565 0 17 37 18 37 9 38 10 38 15 50 15 50 10 30 10 30 22 75 21 75 13 35 12 35 16 55 16 55 22 75 21 75 13 35 13 35 22 75 22 75 13 35 12 35 7 38 7 38 15 6 15 6 10 -10 9 -9 9 -44 9 -45 12 -50 13 -50 17 -65 17 -65 13 -50 12 -50 8 -35 8 -35 22 -88 23 -89 24 -9 24 -9 252 0 252 0 14 9 14 9 -17 59 -17 58 -10 30 -10 30 -14 45 -13 45 -16 55 -17 55 -13 50 -14 50 -9 25 -10 25 -16 55 -16 55 -22 75 -21 75 -13 35 -13 35 -21 75 -22 75 -16 55 -15 55 -14 33 -14 33 0 12 0 12 -21 70 -22 70 -15 43 -15 42 -329 0 -329 0 -18 -43z" />
          </g>
        </svg>
      </div>
      <div>
        <div class="tf-footer-name">TRANS·FIL S.R.L.</div>
        <div class="tf-footer-tag">{content.footer.tag}</div>
      </div>
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.tech}</div>
      {content.tech.map((t) => <a href="#tech" aria-label={`${content.nav.tech}: ${t.title}`}>{t.title}</a>)}
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.services}</div>
      {content.services.items.map((s) => <a href="#services" aria-label={`${content.nav.services}: ${s.title}`}>{s.title}</a>)}
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.contact}</div>
      <a href="mailto:ventas@transfil.com.ar">ventas@transfil.com.ar</a>
      <a href="tel:+5493513820321">+54 9 3513 82-0321</a>
      <span class="tf-footer-static">{content.contact.addr}</span>
      <div class="tf-footer-social">
        <a href="https://wa.me/5493513820321" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M3 21 4.5 16.5 A9 9 0 1 1 8 19.5 L3 21Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="tf-footer-rule" aria-hidden="true" />
  <div class="tf-footer-bot">
    <span>© {year} {content.footer.built} — {content.footer.rights}</span>
    <span class="tf-footer-build">
      <i aria-hidden="true" />
      <span>ISO 9001</span>
    </span>
    <span class="tf-mono">CÓRDOBA · AR · 31°24′S · 64°11′W</span>
  </div>
</footer>
