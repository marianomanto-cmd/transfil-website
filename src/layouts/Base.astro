---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Content, Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  content: Content;
  pathname: string;
  noindex?: boolean;
}

const { lang, content, pathname, noindex = false } = Astro.props;
const site = 'https://www.transfil.com.ar';
const canonical = `${site}${pathname}`;
const ogImage = `${site}/img/og-image.jpg`;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site}/#organization`,
  name: 'Trans-Fil S.R.L.',
  alternateName: 'Trans-Fil',
  url: `${site}/`,
  logo: `${site}/favicon.svg`,
  image: ogImage,
  description: content.meta.description,
  foundingDate: '1989',
  founders: [{ '@type': 'Person', name: 'Mantovani' }],
  inLanguage: content.htmlLang,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Francisco de Arteaga 3043',
    addressLocality: 'Córdoba',
    addressRegion: 'Córdoba',
    addressCountry: 'AR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -31.4036,
    longitude: -64.1924,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+5493513820321',
      contactType: 'sales',
      email: 'ventas@transfil.com.ar',
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Brazil' },
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Country', name: 'Peru' },
        { '@type': 'Country', name: 'Bolivia' },
        { '@type': 'Country', name: 'Paraguay' },
        { '@type': 'Country', name: 'Uruguay' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Country', name: 'Ecuador' },
        { '@type': 'Country', name: 'Mexico' },
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'Dominican Republic' },
        { '@type': 'Country', name: 'Puerto Rico' },
        { '@type': 'Country', name: 'Spain' },
      ],
      availableLanguage: ['Spanish', 'English'],
    },
  ],
  industry: 'Industrial Machinery Manufacturing',
  makesOffer: content.tech.map((t) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Product',
      '@id': `${site}/#product-${t.id}`,
      name: t.title,
      description: t.desc,
      category: 'Industrial Machinery',
      manufacturer: { '@id': `${site}/#organization` },
    },
  })),
};

// Each service Trans-Fil provides (S01..S04 in content.services.items)
// as its own Service node, attributed back to the org via @id.
const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': content.services.items.map((s) => ({
    '@type': 'Service',
    '@id': `${site}/#service-${s.code.toLowerCase()}`,
    name: s.title,
    description: s.desc,
    serviceType: s.title,
    provider: { '@id': `${site}/#organization` },
    areaServed: { '@id': `${site}/#organization` },
  })),
};

// FAQPage with the bilingual Q&A list — primary surface for AI search
// engines (Perplexity / ChatGPT / Google AI Overviews) to cite Trans-Fil
// answers about location, products, history, countries served, etc.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: content.htmlLang,
  mainEntity: content.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---
<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0e0e10" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-AR" href={`${site}/`} />
    <link rel="alternate" hreflang="en-US" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trans-Fil" />
    <meta property="og:title" content={content.meta.ogTitle} />
    <meta property="og:description" content={content.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={content.meta.ogImageAlt} />
    <meta property="og:locale" content={content.ogLocale} />
    <meta property="og:locale:alternate" content={content.altLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.ogTitle} />
    <meta name="twitter:description" content={content.meta.twitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={content.meta.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(servicesJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <!-- Google tag (gtag.js) — GA4. Fires a manual page_view after each
         astro:page-load except the first (the 'config' line above already
         counts the initial pageview). -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Y6H3JFZNNM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Y6H3JFZNNM');
      let __gtagFirst = true;
      document.addEventListener('astro:page-load', function () {
        if (__gtagFirst) { __gtagFirst = false; return; }
        if (typeof gtag !== 'function') return;
        gtag('event', 'page_view', {
          page_path: location.pathname + location.search,
          page_title: document.title,
          page_location: location.href,
        });
      });
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="tf-skip-link" href="#main">{content.htmlLang.startsWith('es') ? 'Saltar al contenido' : 'Skip to content'}</a>

    {/* Visually-hidden but indexable 'About' block for AI search engines
        and screen readers. Mirrors the FAQPage JSON-LD in human-readable
        prose so crawlers can extract facts even without parsing JSON-LD. */}
    <section class="tf-sr-only" aria-labelledby="about-heading">
      <h2 id="about-heading">{content.htmlLang.startsWith('es') ? 'Sobre Trans-Fil' : 'About Trans-Fil'}</h2>
      <p>{content.about}</p>
      <h3>{content.htmlLang.startsWith('es') ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h3>
      <dl>
        {content.faq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))}
      </dl>
    </section>

    <slot />
    <script>
      function init() {
        // Reveal-on-scroll
        const sections = document.querySelectorAll('.tf-section');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1 }
        );
        sections.forEach((s) => io.observe(s));

        // Split section H2 text into per-word spans so the headline cascades
        // word-by-word. Skip headings that already have manual <span>/<em>
        // children (e.g. Industries title which has a two-tone split).
        document.querySelectorAll('.tf-h2').forEach((h) => {
          if (h.querySelector('span, em')) return;
          if ((h as HTMLElement).dataset.split === '1') return;
          (h as HTMLElement).dataset.split = '1';
          const text = h.textContent || '';
          h.textContent = '';
          let i = 0;
          for (const part of text.split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              h.appendChild(document.createTextNode(part));
            } else {
              const w = document.createElement('span');
              w.textContent = part;
              w.style.setProperty('--i', String(i++));
              h.appendChild(w);
            }
          }
        });

        // Magnetic primary CTA — subtle attraction to cursor (fine pointers)
        if (window.matchMedia('(pointer: fine)').matches) {
          const bind = (btn: HTMLElement) => {
            let raf = 0;
            const reset = () => {
              btn.style.transform = '';
            };
            btn.addEventListener('mousemove', (e: MouseEvent) => {
              if (raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                const r = btn.getBoundingClientRect();
                const dx = (e.clientX - (r.left + r.width / 2)) * 0.25;
                const dy = (e.clientY - (r.top + r.height / 2)) * 0.25;
                btn.style.transform = `translate(${dx}px, ${dy}px)`;
              });
            });
            btn.addEventListener('mouseleave', reset);
          };
          const scan = () =>
            document.querySelectorAll('.tf-btn-magnetic').forEach((b) => {
              if (!(b as HTMLElement).dataset.magnetic) {
                (b as HTMLElement).dataset.magnetic = '1';
                bind(b as HTMLElement);
              }
            });
          scan();
          if (!(window as any).__tfMagObs) {
            (window as any).__tfMagObs = true;
            new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
          }
        }
      }

      // Smooth scroll for in-page anchors — bound once. With ClientRouter the
      // <script> in the body re-executes on each transition, so guard with a
      // window flag to avoid stacking listeners.
      if (!(window as any).__tfClickBound) {
        (window as any).__tfClickBound = true;
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const a = target.closest('a[href^="#"]') as HTMLAnchorElement | null;
          if (!a) return;
          const href = a.getAttribute('href');
          if (!href || href === '#') return;
          const el = document.querySelector(href);
          if (!el) return;
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      // astro:page-load fires on the initial load AND after each view transition.
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
