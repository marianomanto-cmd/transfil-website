---
import type { Content } from '../i18n/content';
import Section from './Section.astro';

interface Props { content: Content }
const { content } = Astro.props;
const c = content.services;

// Per-service abstract glyph. Geometric line-art that echoes the site's
// industrial editorial style; sized at 24px viewBox so they crisp at 22-28px.
const icons: Record<string, string> = {
  // S01 Repairs — open-end wrench
  S01: `<path d="M19.2 4.4a4 4 0 0 0-5 5.2L6.3 17.5a2.2 2.2 0 1 0 3.1 3.1l7.9-7.9a4 4 0 0 0 5.2-5L20 10l-2.5-2.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />`,
  // S02 Retrofitting — recursive arrows (upgrade loop)
  S02: `<path d="M4.5 12a7.5 7.5 0 0 1 12-5.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <path d="M14.5 3.5l3 2.8-3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M19.5 12a7.5 7.5 0 0 1-12 5.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <path d="M9.5 20.5l-3-2.8 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />`,
  // S03 Maintenance — calendar with check (scheduled visits)
  S03: `<rect x="3.5" y="5.5" width="17" height="15" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />
  <line x1="3.5" y1="10" x2="20.5" y2="10" stroke="currentColor" stroke-width="1.4" />
  <line x1="8" y1="3.5" x2="8" y2="7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <line x1="16" y1="3.5" x2="16" y2="7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <path d="M8.5 15l2.5 2.5L16 13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />`,
  // S04 Custom engineering — set-square + compass dot (drafting)
  S04: `<path d="M12 3 21 20H3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
  <circle cx="12" cy="13.5" r="2.2" fill="none" stroke="currentColor" stroke-width="1.4" />
  <line x1="12" y1="3" x2="12" y2="11.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />`,
};
---
<Section id="services" eyebrow={c.eyebrow} title={c.title} sub={c.sub} dark={true} screenLabel="04 Services" num="04">
  <div class="tf-services is-stepper">
    {c.items.map((s) => (
      <article
        id={`service-${s.code.toLowerCase()}`}
        class="tf-service"
        style="scroll-margin-top: calc(var(--header-h) + 24px);"
      >
        <div class="tf-service-hd">
          <span class="tf-mono">{s.code}</span>
          <span class="tf-service-rule" aria-hidden="true" />
          <span class="tf-svc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" set:html={icons[s.code] ?? ''} />
          </span>
        </div>
        <h3 class="tf-service-title">{s.title}</h3>
        <p class="tf-service-desc">{s.desc}</p>
        <span class="tf-svc-accent" aria-hidden="true" />
      </article>
    ))}
  </div>
</Section>
