</div>

<script>
  /**
   * Avance por etapa. Un solo listener de scroll; el progreso sale de la
   * posición del bloque, así que funciona con cualquier contenedor. Si GSAP
   * está cargado, suaviza el desplazamiento del foco; si no, salta.
   */
  type SdWin = typeof window & { __tfSdCleanup?: () => void };

  function initSystemDiagram() {
    const w = window as SdWin;
    // ClientRouter swaps the document on navigation, so the previous page's
    // listeners would survive and keep measuring a detached node on every
    // scroll frame. Tear them down before binding new ones.
    w.__tfSdCleanup?.();
    w.__tfSdCleanup = undefined;

    const root = document.querySelector<HTMLElement>('.tf-sd');
    if (!root) return;

    const ZONES = [
      { x: 20, y: 30, w: 320, h: 600 },
      { x: 262, y: 190, w: 480, h: 240 },
      { x: 676, y: 196, w: 220, h: 268 },
      { x: 840, y: 90, w: 470, h: 500 },
    ];
    const cam = { ...ZONES[0] };
    const br = [...root.querySelectorAll<SVGPathElement>('[data-br]')];
    const halo = root.querySelector<SVGRectElement>('.tf-sd-halo');
    const mixA = root.querySelector<SVGStopElement>('.tf-sd-mix-a');
    const mixB = root.querySelector<SVGStopElement>('.tf-sd-mix-b');
    const prog = root.querySelector<HTMLElement>('.tf-sd-prog span');
    const frame = root.querySelector<HTMLElement>('.tf-sd-frame');
    const stageEl = root.querySelector<HTMLElement>('.tf-sd-stage');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.tf-sd-tab')];
    const lessMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let stage = -1;
    let raf = 0;

    const drawZone = () => {
      const { x, y, w, h } = cam;
      const t = 34;
      const d = [
        `M${x} ${y + t}V${y}h${t}`,
        `M${x + w - t} ${y}h${t}v${t}`,
        `M${x + w} ${y + h - t}V${y + h}h-${t}`,
        `M${x + t} ${y + h}H${x}V${y + h - t}`,
      ];
      br.forEach((p, i) => p.setAttribute('d', d[i]));
      if (halo) {
        halo.setAttribute('x', String(x - 70));
        halo.setAttribute('y', String(y - 50));
        halo.setAttribute('width', String(w + 140));
        halo.setAttribute('height', String(h + 100));
      }
    };

    /** Pan the frame so the active zone is on screen. No-ops on desktop,
        where the whole plan already fits. */
    const panToZone = (z: { x: number; w: number }) => {
      if (!frame || !stageEl) return;
      const max = frame.scrollWidth - frame.clientWidth;
      if (max <= 1) return;
      const sw = stageEl.getBoundingClientRect().width;
      const centre = ((z.x + z.w / 2) / 1320) * sw;
      const left = Math.max(0, Math.min(max, centre - frame.clientWidth / 2));
      frame.scrollTo({ left, behavior: lessMotion() ? 'auto' : 'smooth' });
    };

    const setStage = (i: number) => {
      if (i === stage) return;
      stage = i;
      root.dataset.stage = String(i);
      tabs.forEach((b, n) => b.setAttribute('aria-current', n === i ? 'step' : 'false'));
      const z = ZONES[i];
      panToZone(z);
      const g = (window as any).gsap;
      if (g && !lessMotion()) {
        g.to(cam, { ...z, duration: 0.85, ease: 'power3.inOut', onUpdate: drawZone });
      } else {
        Object.assign(cam, z);
        drawZone();
      }
    };

    const apply = (p: number) => {
      const q = Math.max(0, Math.min(1, p));
      if (prog) prog.style.width = `${(q * 100).toFixed(2)}%`;
      // Pasado el filtro plano el baño ya está limpio: sólo la boca de entrada
      // conserva el tinte contaminado, y retrocede con el avance.
      const cross = 0.1 - q * 0.07;
      mixA?.setAttribute('offset', cross.toFixed(3));
      mixB?.setAttribute('offset', (cross + 0.07).toFixed(3));
      setStage(Math.max(0, Math.min(3, Math.floor(q * 3.999))));
    };

    /** How much scroll the block actually owns. 0 when the pin is off —
        below 860px and whenever the visitor asked for less motion. */
    const runway = () => root.getBoundingClientRect().height - window.innerHeight;

    const tick = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        // Without a pin there is no run to read, and re-applying 0 here
        // would fight whatever the rail just selected.
        const span = runway();
        if (span <= 1) return;
        apply(-root.getBoundingClientRect().top / span);
      });
    };

    tabs.forEach((b, i) => {
      b.addEventListener('click', () => {
        const span = runway();
        if (span > 1) {
          // Pinned: move the scroll and let the tick render the stage.
          const r = root.getBoundingClientRect();
          window.scrollTo({
            top: window.scrollY + r.top + span * ((i + 0.5) / 4),
            behavior: lessMotion() ? 'auto' : 'smooth',
          });
        } else {
          // Not pinned: the rail *is* the navigation. Render the midpoint of
          // the stage so the gradient and the progress bar stay meaningful.
          apply((i + 0.5) / 4);
        }
      });
    });

    document.addEventListener('scroll', tick, { passive: true, capture: true });
    window.addEventListener('resize', tick);
    w.__tfSdCleanup = () => {
      document.removeEventListener('scroll', tick, { capture: true } as EventListenerOptions);
      window.removeEventListener('resize', tick);
      if (raf) cancelAnimationFrame(raf);
    };

    drawZone();
    // Seed the first frame: pinned reads the scroll, unpinned opens on F01.
    if (runway() > 1) tick();
    else apply(0.125);
  }

  document.addEventListener('astro:page-load', initSystemDiagram);
</script>

