---
import type { Content, Lang } from '../i18n/content';
import { pathFor, type PageKey } from '../i18n/routes';

interface Props {
  content: Content;
  lang: Lang;
  /** Page the footer sits on — decides whether anchors stay in-page. */
  page?: PageKey;
}
const { content, lang, page = 'home' } = Astro.props;
const year = new Date().getFullYear();

// On the home the section anchors are in-page; anywhere else (a campaign
// landing) they have to travel back to the home first.
const home = pathFor('home', lang);
const anchor = (hash: string) => (page === 'home' ? hash : `${home}${hash}`);

// Cards that own a landing page (A01 → /conformado) get a footer link.
const landingCards = content.applications.cards.filter((c) => c.link);
---
<footer class="tf-footer">
  <div class="tf-footer-grid">
    <div class="tf-footer-brand">
      <div class="tf-logo-mark" aria-hidden="true">
        <img src="/img/logo-mark.png" width="48" height="40" alt="" />
      </div>
      <div>
        <div class="tf-footer-name">TRANS·FIL S.R.L.</div>
        <div class="tf-footer-tag">{content.footer.tag}</div>
      </div>
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.tech}</div>
      {content.tech.map((t) => <a href={anchor(`#tech-${t.id}`)}>{t.title}</a>)}
      {landingCards.map((c) => (
        <a href={pathFor(c.link!.page, lang)} class="tf-footer-highlight">{c.title}</a>
      ))}
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.services}</div>
      {content.services.items.map((s) => <a href={anchor(`#service-${s.code.toLowerCase()}`)}>{s.title}</a>)}
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.contact}</div>
      <a href="mailto:ventas@transfil.com.ar">ventas@transfil.com.ar</a>
      <a href="tel:+5493513820321">+54 9 3513 82-0321</a>
      <span class="tf-footer-static">{content.contact.addr}</span>
      <div class="tf-footer-social">
        <a href="https://wa.me/5493513820321" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M3 21 4.5 16.5 A9 9 0 1 1 8 19.5 L3 21Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" />
          </svg>
        </a>
        <a href="https://ar.linkedin.com/company/trans---fil" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="tf-footer-rule" aria-hidden="true" />
  <div class="tf-footer-bot">
    <span>© {year} {content.footer.built} — {content.footer.rights}</span>
    <span class="tf-footer-build">
      <i aria-hidden="true" />
      <span>ISO 9001</span>
    </span>
    <span class="tf-mono">CÓRDOBA · AR · 31°24′S · 64°11′W</span>
  </div>
</footer>
