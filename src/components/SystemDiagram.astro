---
/**
 * Esquema de funcionamiento de la central de filtración — apertura de la
 * sección 02 (El sistema) en las landings de aplicación (/conformado).
 *
 * Un solo dibujo, cuatro etapas. El bloque mide 380vh: el esquema queda
 * pegado (sticky) y el scroll avanza F01 → F02 → F03 → F04. Cada etapa
 * ilumina su grupo de equipos y mueve el foco (ticks de esquina + halo);
 * las catorce referencias se mantienen siempre legibles.
 *
 * Lenguaje visual idéntico a MachineDiagram.astro: estructura grafito,
 * líneas técnicas gris medio, azul para el fluido, marrón para la
 * contaminación, grilla de blueprint detrás. Corners a 0, sin sombras.
 *
 * Las referencias son HTML posicionado en % sobre el SVG (no <text>):
 * traducen con el sitio, escalan con `cqw` y se pueden seleccionar.
 *
 * Movimiento: CSS para los loops continuos (giro, gotas, caudal) y un
 * único listener de scroll para el avance por etapa. GSAP es opcional —
 * si `window.gsap` existe se usa para suavizar el movimiento del foco.
 * Todo respeta `prefers-reduced-motion`.
 */
interface Props {
  /** Referencias del esquema, ya localizadas (landings.ts → diagram.labels). */
  labels: {
    dirty: string; attenuator: string; magnetic: string; gravity: string;
    skimmer: string; level: string; lowOut: string; highOut: string;
    clean: string; waste: string; tank: string; exchanger: string;
    bag: string; cabinet: string;
  };
  /** Título corto de cada etapa — F01…F04 (landings.ts → system.blocks[].title). */
  stages: string[];
  /** Rótulo mono sobre el marco y nota de escala. */
  caption: string;
  scaleNote: string;
  /** Texto alternativo del esquema completo. */
  alt: string;
}
const { labels: l, stages, caption, scaleNote, alt } = Astro.props;
const codes = ['F01', 'F02', 'F03', 'F04'];
---

<div class="tf-sd" data-stage="0">
  <div class="tf-sd-pin">
    <div class="tf-sd-head">
      <span class="tf-mono">{caption}</span>
      <span class="tf-mono tf-sd-scale">{scaleNote}</span>
    </div>

    <div class="tf-sd-frame">
      <div class="tf-sd-stage">
        <svg viewBox="0 0 1320 680" preserveAspectRatio="none" class="tf-sd-svg" role="img" aria-label={alt}>
          <defs>
            <pattern id="tf-sd-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M40 0H0v40" fill="none" stroke="#ffffff" stroke-width="1" />
            </pattern>
            <linearGradient id="tf-sd-liquid" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#8f5c2d" stop-opacity=".4" />
              <stop class="tf-sd-mix-a" offset="0.06" stop-color="#6b5535" stop-opacity=".34" />
              <stop class="tf-sd-mix-b" offset="0.13" stop-color="#3a86ff" stop-opacity=".3" />
              <stop offset="1" stop-color="#3a86ff" stop-opacity=".3" />
            </linearGradient>
            <radialGradient id="tf-sd-halo" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#3a86ff" stop-opacity=".16" />
              <stop offset="1" stop-color="#3a86ff" stop-opacity="0" />
            </radialGradient>
          </defs>

          <rect width="1320" height="680" fill="url(#tf-sd-grid)" class="tf-sd-gridfill" />
          <rect class="tf-sd-halo" x="-50" y="-20" width="460" height="700" fill="url(#tf-sd-halo)" />
          <path d="M28 574H1302" fill="none" stroke="#3a3a3f" stroke-width="6" stroke-linecap="square" />

          {/* ── F04 · central de proceso: pileta, bomba, intercambiador, filtros, salidas, tablero ── */}
          <g class="tf-sd-g" data-g="3">
            <rect x="250" y="406" width="590" height="168" fill="#1b1b21" stroke="#6d6d77" stroke-width="1.6" />
            <rect x="254" y="436" width="582" height="134" fill="url(#tf-sd-liquid)" />
            <path d="M254 436h582" fill="none" stroke="#3a86ff" stroke-width="1.6" opacity=".5" />
