---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  sub?: string;
  dark?: boolean;
  screenLabel?: string;
  num?: string;
  class?: string;
}

const { id, eyebrow, title, sub, dark = false, screenLabel, num, class: cls } = Astro.props;
const classes = ['tf-section', dark && 'is-dark', cls].filter(Boolean).join(' ');
---
<section id={id} class={classes} data-screen-label={screenLabel}>
  {(eyebrow || title || sub) && (
    <header class="tf-section-head" data-num={num}>
      {eyebrow && <div class="tf-eyebrow">{eyebrow}</div>}
      {title && <h2 class="tf-h2">{title}</h2>}
      {sub && <p class="tf-section-sub">{sub}</p>}
    </header>
  )}
  <slot />
</section>
