---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Content, Lang } from '../i18n/content';
import {
  SITE,
  LOCALES,
  LOCALE_META,
  altOgLocales,
  alternatesFor,
  urlFor,
  type PageKey,
} from '../i18n/routes';

interface Props {
  lang: Lang;
  content: Content;
  /**
   * Routable page key. Drives canonical + the reciprocal hreflang block.
   * Omitted only by the 404, which is `noindex` and has no alternates.
   */
  page?: PageKey;
  /** Explicit path — only needed when `page` is absent (404). */
  pathname?: string;
  noindex?: boolean;
  /** Per-page SEO overrides. Landings pass their own; the homes don't. */
  meta?: Partial<Content['meta']>;
  /** Page-specific share image. Defaults to the site-wide og-image.jpg. */
  ogImage?: { src: string; width: number; height: number };
  /** FAQ powering the FAQPage JSON-LD + the sr-only block. */
  faq?: { q: string; a: string }[];
  /** Long-form prose for the sr-only About block. */
  about?: string;
  /** Extra JSON-LD nodes (WebPage / Service / BreadcrumbList on landings). */
  extraJsonLd?: Record<string, unknown>[];
  /** Above-the-fold image to preload — the page's LCP candidate. */
  preloadImage?: string;
}

const {
  lang,
  content,
  page,
  pathname,
  noindex = false,
  meta: metaOverride,
  ogImage: ogImageOverride,
  faq = content.faq,
  about = content.about,
  extraJsonLd = [],
  preloadImage,
} = Astro.props;

const site = SITE;
const canonical = page ? urlFor(page, lang) : `${site}${pathname ?? '/'}`;
const meta = { ...content.meta, ...metaOverride };
const og = ogImageOverride ?? { src: '/img/og-image.jpg', width: 1200, height: 630 };
const ogImage = `${site}${og.src}`;
const ogImageType = og.src.endsWith('.webp')
  ? 'image/webp'
  : og.src.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';
const alternates = page ? alternatesFor(page) : [];
const xDefault = page ? urlFor(page, 'es') : null;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site}/#organization`,
  name: 'Trans-Fil S.R.L.',
  alternateName: 'Trans-Fil',
  url: `${site}/`,
  logo: `${site}/favicon-512.png`,
  image: ogImage,
  description: meta.description,
  foundingDate: '1989',
  founders: [{ '@type': 'Person', name: 'Mantovani' }],
  inLanguage: content.htmlLang,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Francisco de Arteaga 2895',
    addressLocality: 'Córdoba',
    addressRegion: 'Córdoba',
    addressCountry: 'AR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -31.4036,
    longitude: -64.1924,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+5493513820321',
      contactType: 'sales',
      email: 'ventas@transfil.com.ar',
      areaServed: [
        { '@type': 'Country', name: 'Argentina' },
        { '@type': 'Country', name: 'Brazil' },
        { '@type': 'Country', name: 'Chile' },
        { '@type': 'Country', name: 'Peru' },
        { '@type': 'Country', name: 'Bolivia' },
        { '@type': 'Country', name: 'Paraguay' },
        { '@type': 'Country', name: 'Uruguay' },
        { '@type': 'Country', name: 'Colombia' },
        { '@type': 'Country', name: 'Ecuador' },
        { '@type': 'Country', name: 'Mexico' },
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'Dominican Republic' },
        { '@type': 'Country', name: 'Puerto Rico' },
        { '@type': 'Country', name: 'Spain' },
      ],
      availableLanguage: LOCALES.map((l) => LOCALE_META[l].schemaLanguage),
    },
  ],
  industry: 'Industrial Machinery Manufacturing',
  makesOffer: content.tech.map((t) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Product',
      '@id': `${site}/#product-${t.id}`,
      name: t.title,
      description: t.desc,
      category: 'Industrial Machinery',
      manufacturer: { '@id': `${site}/#organization` },
    },
  })),
};

// Each service Trans-Fil provides (S01..S04 in content.services.items)
// as its own Service node, attributed back to the org via @id.
const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': content.services.items.map((s) => ({
    '@type': 'Service',
    '@id': `${site}/#service-${s.code.toLowerCase()}`,
    name: s.title,
    description: s.desc,
    serviceType: s.title,
    provider: { '@id': `${site}/#organization` },
    areaServed: { '@id': `${site}/#organization` },
  })),
};

// FAQPage with the bilingual Q&A list — primary surface for AI search
// engines (Perplexity / ChatGPT / Google AI Overviews) to cite Trans-Fil
// answers about location, products, history, countries served, etc.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  inLanguage: content.htmlLang,
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---
<!doctype html>
<html lang={content.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PV9STD3');</script>
    <!-- End Google Tag Manager -->

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0e0e10" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trans-Fil" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta property="og:locale" content={content.ogLocale} />
    {altOgLocales(lang).map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.twitterDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(servicesJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    {extraJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <!-- GA4 now lives inside the GTM container (GTM-PV9STD3); the initial
         page_view is sent by the GA4 config tag when GTM loads. This pushes a
         page_view to the dataLayer on every astro:page-load except the first,
         so client-side view transitions are tracked too. -->
    <script is:inline>
      (function () {
        var first = true;
        document.addEventListener('astro:page-load', function () {
          if (first) { first = false; return; }
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'page_view',
            page_path: location.pathname + location.search,
            page_title: document.title,
            page_location: location.href,
          });
        });
      })();
    </script>

    <!-- Key events for GTM/GA4: WhatsApp and phone link clicks. One delegated
         listener on document (capture phase) catches every current and future
         wa.me / tel: link — FAB, footer and contact section alike. -->
    <script is:inline>
      (function () {
        if (window.__tfLinkEvents) return;
        window.__tfLinkEvents = true;
        document.addEventListener('click', function (e) {
          var t = e.target;
          var a = t && t.closest ? t.closest('a[href]') : null;
          if (!a) return;
          var href = (a.getAttribute('href') || '').toLowerCase();
          var ev = null;
          if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) ev = 'click_whatsapp';
          else if (href.indexOf('tel:') === 0) ev = 'click_phone';
          if (!ev) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: ev, link_url: a.href });
        }, true);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PV9STD3"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a class="tf-skip-link" href="#main">{content.ui.skipToContent}</a>

    {/* Visually-hidden but indexable 'About' block for AI search engines
        and screen readers. Mirrors the FAQPage JSON-LD in human-readable
        prose so crawlers can extract facts even without parsing JSON-LD. */}
    <section class="tf-sr-only" aria-labelledby="about-heading">
      <h2 id="about-heading">{content.ui.aboutHeading}</h2>
      <p>{about}</p>
      <h3>{content.ui.faqHeading}</h3>
      <dl>
        {faq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))}
      </dl>
    </section>

    <slot />
    <script>
      function init() {
        // Reveal-on-scroll
        const sections = document.querySelectorAll('.tf-section');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1 }
        );
        sections.forEach((s) => io.observe(s));

        // Split section H2 text into per-word spans so the headline cascades
        // word-by-word. Skip headings that already have manual <span>/<em>
        // children (e.g. Industries title which has a two-tone split).
        document.querySelectorAll('.tf-h2').forEach((h) => {
          if (h.querySelector('span, em')) return;
          if ((h as HTMLElement).dataset.split === '1') return;
          (h as HTMLElement).dataset.split = '1';
          const text = h.textContent || '';
          h.textContent = '';
          let i = 0;
          for (const part of text.split(/(\s+)/)) {
            if (!part) continue;
            if (/^\s+$/.test(part)) {
              h.appendChild(document.createTextNode(part));
            } else {
              const w = document.createElement('span');
              w.textContent = part;
              w.style.setProperty('--i', String(i++));
              h.appendChild(w);
            }
          }
        });

        // Magnetic primary CTA — subtle attraction to cursor (fine pointers,
        // and only when the user hasn't opted out of motion).
        if (
          window.matchMedia('(pointer: fine)').matches &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          const bind = (btn: HTMLElement) => {
            let raf = 0;
            const reset = () => {
              btn.style.transform = '';
            };
            btn.addEventListener('mousemove', (e: MouseEvent) => {
              if (raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                const r = btn.getBoundingClientRect();
                const dx = (e.clientX - (r.left + r.width / 2)) * 0.25;
                const dy = (e.clientY - (r.top + r.height / 2)) * 0.25;
                btn.style.transform = `translate(${dx}px, ${dy}px)`;
              });
            });
            btn.addEventListener('mouseleave', reset);
          };
          const scan = () =>
            document.querySelectorAll('.tf-btn-magnetic').forEach((b) => {
              if (!(b as HTMLElement).dataset.magnetic) {
                (b as HTMLElement).dataset.magnetic = '1';
                bind(b as HTMLElement);
              }
            });
          scan();
          if (!(window as any).__tfMagObs) {
            (window as any).__tfMagObs = true;
            new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
          }
        }
      }

      // Smooth scroll for in-page anchors — bound once. With ClientRouter the
      // <script> in the body re-executes on each transition, so guard with a
      // window flag to avoid stacking listeners.
      if (!(window as any).__tfClickBound) {
        (window as any).__tfClickBound = true;
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const a = target.closest('a[href^="#"]') as HTMLAnchorElement | null;
          if (!a) return;
          const href = a.getAttribute('href');
          if (!href || href === '#') return;
          const el = document.querySelector(href);
          if (!el) return;
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      // astro:page-load fires on the initial load AND after each view transition.
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
