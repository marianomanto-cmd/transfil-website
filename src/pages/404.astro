---
import Base from '../layouts/Base.astro';
import { CONTENT, type Lang } from '../i18n/content';
import { langFromPath, pathFor } from '../i18n/routes';

// Switch on the request path so /en/foo, /pt/foo and their deep-links land
// on the right locale even though Astro routes everything unknown here.
const lang: Lang = langFromPath(Astro.url.pathname);
const content = CONTENT[lang];

// The two links offered besides "back home": the same page in the other
// two locales, labelled in their own language.
const OTHER_LABEL: Record<Lang, string> = {
  es: 'Versión en español',
  en: 'English version',
  pt: 'Versão em português',
};

const COPY: Record<Lang, { tag: string; title: string; sub: string; cta: string }> = {
  es: {
    tag: '[ 404 — Página no encontrada ]',
    title: 'No encontramos esa ruta.',
    sub: 'Es posible que la página haya sido movida o que la dirección esté mal escrita. Volvé al inicio para seguir explorando Trans-Fil.',
    cta: 'Volver al inicio',
  },
  en: {
    tag: '[ 404 — Page not found ]',
    title: "We couldn't find that page.",
    sub: 'The page may have moved or the URL may be mistyped. Head back to the home page to keep exploring Trans-Fil.',
    cta: 'Back to home',
  },
  pt: {
    tag: '[ 404 — Página não encontrada ]',
    title: 'Não encontramos essa página.',
    sub: 'A página pode ter sido movida ou o endereço pode estar errado. Volte ao início para continuar explorando a Trans-Fil.',
    cta: 'Voltar ao início',
  },
};

const copy = COPY[lang];
const others = (Object.keys(COPY) as Lang[]).filter((l) => l !== lang);
---
<Base lang={lang} content={content} pathname="/404" noindex>
  <main id="main" class="tf-404">
    <span class="tf-mono tf-404-code">{copy.tag}</span>
    <h1 class="tf-404-title">{copy.title}</h1>
    <p class="tf-404-sub">{copy.sub}</p>
    <div class="tf-404-actions">
      <a href={pathFor('home', lang)} class="tf-btn tf-btn-primary">
        <span>{copy.cta}</span>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </a>
      {others.map((l) => (
        <a href={pathFor('home', l)} class="tf-btn tf-btn-ghost" hreflang={l}>{OTHER_LABEL[l]}</a>
      ))}
    </div>
  </main>
</Base>

<style>
  .tf-404 {
    min-height: calc(100vh - 200px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(72px, 10vw, 140px) clamp(20px, 4vw, 96px);
    max-width: 720px;
    margin: 0 auto;
    gap: 20px;
  }
  .tf-404-code {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tf-404-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 7vw, 88px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }
  .tf-404-sub {
    font-size: clamp(15px, 1.2vw, 18px);
    color: var(--fg-2);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0;
  }
  .tf-404-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
</style>
