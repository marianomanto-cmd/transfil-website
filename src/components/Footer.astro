---
import type { Content } from '../i18n/content';

interface Props { content: Content }
const { content } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="tf-footer">
  <div class="tf-footer-grid">
    <div class="tf-footer-brand">
      <div class="tf-logo-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="40" height="40">
          <path d="M16 4 L28 28 L4 28 Z M16 14 L23 25 L9 25 Z"
                fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter" />
          <circle cx="16" cy="11" r="2" fill="currentColor" />
        </svg>
      </div>
      <div>
        <div class="tf-footer-name">TRANS·FIL S.R.L.</div>
        <div class="tf-footer-tag">{content.footer.tag}</div>
      </div>
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.tech}</div>
      {content.tech.map((t) => <a href="#tech">{t.title}</a>)}
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.services}</div>
      {content.services.items.map((s) => <a href="#services">{s.title}</a>)}
    </div>
    <div class="tf-footer-col">
      <div class="tf-footer-h">{content.nav.contact}</div>
      <a href="mailto:mantovanimariano@transfil.com.ar">mantovanimariano@transfil.com.ar</a>
      <a href="tel:+543514650687">+54 (351) 465 0687</a>
      <span class="tf-footer-static">{content.contact.addr}</span>
      <div class="tf-footer-social">
        <a href="https://instagram.com/TransFilSrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="0" fill="none" stroke="currentColor" stroke-width="1.4" />
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
          </svg>
        </a>
        <a href="https://wa.me/5493513115838" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M3 21 4.5 16.5 A9 9 0 1 1 8 19.5 L3 21Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="miter" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="tf-footer-rule" aria-hidden="true" />
  <div class="tf-footer-bot">
    <span>© {year} {content.footer.built} — {content.footer.rights}</span>
    <span class="tf-footer-build">
      <i aria-hidden="true" />
      <span>ISO 9001</span>
    </span>
    <span class="tf-mono">CÓRDOBA · AR · 31°24′S · 64°11′W</span>
  </div>
</footer>
