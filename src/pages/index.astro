---
import Base from '../layouts/Base.astro';
import { CONTENT } from '../i18n/content';
import { Header } from '../components/Header';
import { Hero } from '../components/Hero';
import { TechSection } from '../components/TechSection';
import AplicacionesSection from '../components/AplicacionesSection.astro';
import { CatalogsSection } from '../components/CatalogsSection';
import ProcessSection from '../components/ProcessSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import { IndustriesSection } from '../components/IndustriesSection';
import HistorySection from '../components/HistorySection.astro';
import { ContactSection } from '../components/ContactSection';
import Footer from '../components/Footer.astro';
import { WhatsAppFAB } from '../components/WhatsAppFAB';
import { BackToTop } from '../components/BackToTop';

const content = CONTENT.es;
---
<Base lang="es" content={content} page="home">
  <Header lang="es" nav={content.nav} langSwitch={content.langSwitch} client:load />
  <main id="main">
    <Hero
      hero={content.hero}
      chips={content.chips}
      workshopActive={content.workshopActive}
      client:load
    />
    <TechSection capabilities={content.capabilities} tech={content.tech} client:visible />
    <AplicacionesSection content={content} />
    <CatalogsSection
      catalogs={content.catalogs}
      ui={{ download: content.ui.download, close: content.ui.close }}
      client:visible
    />
    <ProcessSection content={content} />
    <ServicesSection content={content} />
    <IndustriesSection
      industries={content.industries}
      lang={content.lang}
      ui={{ coverage: content.ui.coverage, countriesReached: content.ui.countriesReached }}
      client:visible
    />
    <HistorySection content={content} />
    <ContactSection
      contact={content.contact}
      lang={content.lang}
      whatsappMessage={content.whatsappMessage}
      workshopActive={content.workshopActive}
      client:visible
    />
  </main>
  <Footer content={content} lang="es" />
  <WhatsAppFAB message={content.whatsappMessage} client:idle />
  <BackToTop label={content.backToTop} client:idle />
</Base>
